# Copy to ".env" and adjust for your environment.
# phpdotenv: use double quotes for values that contain # or spaces.

APP_ENV=local
APP_TIMEZONE=Europe/London
APP_DISPLAY_ERRORS=on

# tutorapp/newadmin pagination (optional)
NEWADMIN_PAGE_SIZE=15
# Paths from tutorapp/newadmin/ to learner upload|review|plan dirs. Default ../lms = tutorapp/lms. Use ../../lms if files live under project-root lms/.
# NEWADMIN_LEARNER_FILES_BASE=../../lms

# tutorapp/tms* banner title (quote if the value contains spaces)
TUTORAPP_TMS_SITENAME="Right2Thrive UK Collective Careers Hub"
# tutorapp/tms + tmsnew footer (Careers)
TUTORAPP_COPYRIGHT_OWNER="Right2Thrive UK Ltd"
# Second site — Wellbeing (link label + URL; use in nav)
TUTORAPP_WELLBEING_HUB_NAME="Right2Thrive UK Wellbeing Hub"
# Careers sidebar logo: optional override (root-relative or full URL). Leave unset — auto-detect from REQUEST_URI + SCRIPT_NAME (handles /app21new/app21/...).
# TUTORAPP_CAREERS_LOGO=/app21new/app21/lms/images/logo.png
# tutorapp/lms* legacy title
TUTORAPP_LMS_SITENAME="CareerPaths Online :: "

SITE_NAME=" - Right2Thrive UK Collective Careers Hub "
SITE_WELLBEING_HUB_URL=https://www.right2thriveuk.com/
# Public nav (optional overrides — defaults: about.php, workshops.php on this site)
# SITE_ABOUT_URL=https://www.right2thriveuk.com/about/
# SITE_WORKSHOPS_URL=workshops.php
PAGE_SIZE=10
ADMIN_EMAIL=info@right2thrive.org

DB_HOST=localhost
DB_USERNAME=your_mysql_user
DB_PASSWORD="your_mysql_password"
DB_DATABASE=your_database

# tutorapp/* legacy modules — leave blank to reuse DB_* above, or set for a second schema/user.
TUTORAPP_DB_HOST=
TUTORAPP_DB_USERNAME=
TUTORAPP_DB_PASSWORD=
TUTORAPP_DB_DATABASE=

# tutorapp/lms/db.php — optional GSC credentials (defaults to tutorapp DB if unset)
TUTORAPP_GSC_DB_HOST=
TUTORAPP_GSC_DB_USERNAME=
TUTORAPP_GSC_DB_PASSWORD=
TUTORAPP_GSC_DB_DATABASE=

# tutorapp/dbconfig.php — optional careerpath schema (defaults to GSC/tutorapp)
CAREERPATH_DB_HOST=
CAREERPATH_DB_USERNAME=
CAREERPATH_DB_PASSWORD=
CAREERPATH_DB_DATABASE=

# PHPMailer / SMTP (login alerts, registration verification, etc.)
MAIL_HOST=mail.21kdigitalmedia.com
MAIL_USERNAME=hello@21kdigitalmedia.com
MAIL_PASSWORD=
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=hello@21kdigitalmedia.com
MAIL_FROM_NAME="Right2Thrive UK Collective Careers Hub"

# Routing (paths relative to app root URL, e.g. /app21/)
TUTORAPP_LOGIN_PATH=tutorapp/user_login.php
TUTORAPP_TMS_DASHBOARD=tutorapp/tmsnew/index.php
TUTORAPP_TPM_DASHBOARD=tutorapp/tpm/index.php

# Paths relative to tutorapp/ folder (used by tutorapp/user_login redirects)
TUTORAPP_LOCAL_TMS_INDEX=tmsnew/index.php
TUTORAPP_LOCAL_LMS_INDEX=lms/index.php
TUTORAPP_LOCAL_TPM_INDEX=tpm/index.php
