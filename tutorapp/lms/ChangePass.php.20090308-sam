<script language="JavaScript">
function closewin()
{
	document.location='ChangePass.php';
}
function validation()
{
	if (document.FRMLEARNCHANGEPASSWORD.TXLEARNOLDPASSWORD.value == "")
	{	
		alert("Please enter old password !!");
		document.FRMLEARNCHANGEPASSWORD.TXLEARNOLDPASSWORD.focus();
		return false;
	}
	if (document.FRMLEARNCHANGEPASSWORD.TXLEARNNEWPASSWORD.value == "")
	{	
		alert("Please enter new password !!");
		document.FRMLEARNCHANGEPASSWORD.TXLEARNNEWPASSWORD.focus();
		return false;
	}
	if(document.FRMLEARNCHANGEPASSWORD.TXLEARNNEWPASSWORD.value.length<4)
	{	
		alert("Password must be more than 4 character!");
		document.FRMLEARNCHANGEPASSWORD.TXLEARNNEWPASSWORD.focus();
		return false;
	}
	if(document.FRMLEARNCHANGEPASSWORD.TXLEARNNEWPASSWORD.value.length>16)
	{	
		alert("Password not more than 16 character!");
		document.FRMLEARNCHANGEPASSWORD.TXLEARNNEWPASSWORD.focus();
		return false;
	}
	
	if (document.FRMLEARNCHANGEPASSWORD.TXLEARNCONFIRMPASSWORD.value == "")
	{	
		alert("Please enter confirm password !!");
		document.FRMLEARNCHANGEPASSWORD.TXLEARNCONFIRMPASSWORD.focus();
		return false;
	}
	if (document.FRMLEARNCHANGEPASSWORD.TXLEARNNEWPASSWORD.value != document.FRMLEARNCHANGEPASSWORD.TXLEARNCONFIRMPASSWORD.value)
	{	
		alert("new password and confirm password must be same !!");
		document.FRMLEARNCHANGEPASSWORD.TXLEARNNEWPASSWORD.focus();
		document.FRMLEARNCHANGEPASSWORD.TXLEARNCONFIRMPASSWORD.value = "";
		return false;
	}
	return true;	
}
</script>

